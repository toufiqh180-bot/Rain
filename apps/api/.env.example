# --- Required ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Any Postgres works: local Docker, Neon, Supabase, RDS, Railway.
DATABASE_URL=postgres://rain:local-development-only@localhost:5432/rain
DATABASE_SSL=disable
# Origins allowed to send credentialed requests. Production must not list localhost.
ALLOWED_ORIGINS=http://localhost:5173

# --- Optional, enable as you go ---------------------------------------------
# Presence in the inbox. Without it, everyone reads as offline.
# REDIS_URL=redis://localhost:6379

# Avatar storage. "local" is development only; production requires s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=rain-avatars
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://cdn.yourdomain.com

# Membership. Until these are set, the membership screen reports billing as off.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
BILLING_RETURN_URL=http://localhost:5173

# Shared secret the realtime gateway presents to introspect handshake tokens.
# Generate with: openssl rand -base64 32
# INTERNAL_API_KEY=
