# Rain API — accounts, profiles, connections, DMs, Circles, billing, safety.
# Leave unset locally to run the UI without inventing data: every screen that
# needs a service will say the service is not connected instead of faking it.
VITE_API_URL=http://localhost:4000

# Realtime gateway — random text matching over WebSocket.
VITE_REALTIME_URL=http://localhost:3001
