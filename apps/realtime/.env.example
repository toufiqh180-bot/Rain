PORT=3001
# Comma-separated production origins. Leave unset only for local development.
ALLOWED_ORIGINS=http://localhost:5173
# Use memory only locally. Production refuses to boot without Redis.
MATCHMAKER_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# Where to exchange a client's short-lived handshake token for an account id.
# Production refuses to boot without it, so no anonymous socket reaches the queue.
# AUTH_INTROSPECTION_URL=http://localhost:4000/v1/internal/realtime/introspect
# Shared secret proving to the API that this caller is the gateway.
# Must match INTERNAL_API_KEY in apps/api. Generate with: openssl rand -base64 32
# INTERNAL_API_KEY=
